# Supabase (public — safe for client, protected by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# EAS (optional, for build/submit)
EAS_PROJECT_ID=

# --- Server-side only (used by Supabase Edge Functions, never bundled into the app) ---
# Set these with: supabase secrets set KEY=value
ANTHROPIC_API_KEY=
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
SUPABASE_SERVICE_ROLE_KEY=
